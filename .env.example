# Use npm run setup:local to generate real, separate local secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=18402
APP_ORIGIN=http://localhost:18400
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://:PASSWORD@HOST:6379
S3_ENDPOINT=http://127.0.0.1:18401
S3_PUBLIC_ENDPOINT=http://localhost:18401
S3_BUCKET=astrafile
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
COOKIE_SECRET=
BOOTSTRAP_TOKEN_HASH=
STORAGE_DISK_PATH=.local
TRUST_PROXY=127.0.0.1,::1
# Optional until configured for the deployed environment:
# SMTP_URL=smtps://username:password@your-mail-server:465
# MAIL_FROM=AstraFile <noreply@your-domain>
# SCAN_COMMAND=/usr/bin/clamscan
# BACKUP_ENABLED=true
# BACKUP_DIR=/backups

S3_METRICS_ENDPOINT=http://127.0.0.1:18403/metrics

# Generated independently by setup-local.mjs or setup-privacy-keys.mjs. Never reuse keys.
EMAIL_LOOKUP_KEYS=
SHARE_LOOKUP_KEYS=
FIELD_ENCRYPTION_KEYS=
NETWORK_PRIVACY_KEYS=
BACKUP_ENCRYPTION_KEYS=

# Local Compose only; generated by setup:local, never reuse example passwords.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Optional worker backup configuration:
BACKUP_ENABLED=false
BACKUP_DIR=.local/backups
