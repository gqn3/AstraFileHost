FROM postgres:17.11-alpine@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73
# Update only libraries flagged in the AstraFile image audit. su-exec preserves the
# entrypoint's user-switching interface without retaining the old Go-based gosu.
RUN apk add --no-cache --upgrade libcrypto3 libssl3 libuuid su-exec \
    && rm /usr/local/bin/gosu \
    && sed -i 's/exec gosu postgres/exec su-exec postgres/' /usr/local/bin/docker-entrypoint.sh
